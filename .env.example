# ──── Backend ────
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://preop:password@localhost:5432/preop_intel

# Redis
REDIS_URL=redis://localhost:6379

# Google Gemini (free key from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-key

# FHIR / MeldRx
FHIR_BASE_URL=https://app.meldrx.com/api/fhir/your-workspace-id
FHIR_CLIENT_ID=your-meldrx-client-id
FHIR_CLIENT_SECRET=your-meldrx-client-secret
SMART_CALLBACK_URL=http://localhost:3001/api/auth/callback

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ──── Frontend ────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SMART_CLIENT_ID=your-meldrx-client-id
NEXT_PUBLIC_SMART_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_DEMO_MODE=true

# ──── MCP Server (Po-compatible streamable-HTTP) ────
# Po sends FHIR creds via x-fhir-server-url, x-fhir-access-token, x-patient-id
# request headers — no FHIR creds needed in env for MCP itself.
MCP_PORT=3002

# ──── A2A v1 Orchestrator (Po-compatible) ────
# Po-compatible A2A v1 server. Po reaches it via the agent card at
# https://<host>/.well-known/agent-card.json and POSTs message/send to /.
# Authenticate Po with X-API-Key — generate any random secret and paste the
# same value into Po's "External Agents" registration form.
A2A_PORT=3003
A2A_PUBLIC_URL=http://localhost:3003
PO_AGENT_API_KEY_PRIMARY=change-me-to-a-random-secret
PO_AGENT_API_KEY_SECONDARY=
# Set to "false" only for local dev without Po. Production must keep this on.
PO_AGENT_REQUIRE_API_KEY=true
# Po's FHIR-context extension URI used in message metadata.
FHIR_EXTENSION_URI=https://app.promptopinion.ai/schemas/a2a/v1/fhir-context

# ──── AWS (deployment only) ────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
